# Copier en .env et remplir. Ne jamais committer .env.
# Synchro vers le serveur : « jarvis.ps1 env-pousser » chiffre .env en .env.chiffre (seul fichier de clés suivi par git ; mot de passe demandé, jamais stocké dans le dépôt).
STRIPE_RESTRICTED_KEY=rk_live_xxx
SUPABASE_URL=https://xxx.supabase.co
# Clé anon PUBLIQUE de Supabase (jamais la clé service_role)
SUPABASE_READ_KEY=xxx
# Jeton de la fonction jarvis_stats (lecture seule, créée côté Supabase)
JARVIS_STATS_TOKEN=xxx
# Bot Discord PRIVÉ (voir README, section « Discord ») : jeton du bot et VOTRE identifiant Discord (jamais commités, jamais affichés)
DISCORD_BOT_TOKEN=xxx
DISCORD_USER_ID=xxx
# Alpha Vantage (cours de bourse, gratuit : 25 requêtes par jour)
ALPHAVANTAGE_KEY=xxx
