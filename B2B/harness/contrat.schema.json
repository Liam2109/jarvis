{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrat d'un agent B2B (harness, 15/11/2026)",
  "type": "object",
  "required": ["nom", "responsable", "mission", "statut", "jours", "heures", "fichiers_lus", "fichiers_ecrits", "canaux_discord", "envoi_client", "actions_interdites", "plafonds", "peut_engager", "alerte_si_silence", "tests"],
  "additionalProperties": false,
  "properties": {
    "_aide": {"type": "string"},
    "nom": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "responsable": {"type": "string", "enum": ["Jarvis (CEO)", "Prospection", "Vente", "Argent", "Production", "Liam"]},
    "mission": {"type": "string", "minLength": 10, "maxLength": 220},
    "statut": {"type": "string", "enum": ["actif", "simulation", "inactif", "prevu"]},
    "script": {"type": "string"},
    "jours": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
    "heures": {"type": "object", "required": ["debut", "fin"], "additionalProperties": false,
               "properties": {"debut": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "fin": {"type": "string", "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$"}}},
    "fichiers_lus": {"type": "array", "items": {"type": "string"}},
    "fichiers_ecrits": {"type": "array", "items": {"type": "string"}},
    "canaux_discord": {"type": "array", "items": {"type": "string"}},
    "envoi_client": {"type": "boolean"},
    "actions_interdites": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "plafonds": {"type": "object", "required": ["messages_par_jour"], "properties": {"messages_par_jour": {"type": "integer", "minimum": 0}}},
    "peut_engager": {"const": false},
    "alerte_si_silence": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "alerte_si_pas_de_feuille": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "tests": {"type": "array", "items": {"type": "string"}}
  }
}
