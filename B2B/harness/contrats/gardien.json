 "statut": "inactif",
 "script": "B2B/agents/gardien.py",
 "jours": [
  6
 ],
 "heures": {
  "debut": "21:00",
  "fin": "23:59"
 },
 "fichiers_lus": [
  "B2B/harness/contrats/*.json",
