{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sortie de Jarvis CEO : une décision structurée (harness, 15/11/2026)",
  "type": "object",
  "required": ["date", "constat", "sources", "decision", "agent_cible", "action", "engage_liam", "justification"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
    "constat": {"type": "string", "minLength": 5, "maxLength": 400},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision": {"type": "string", "minLength": 3, "maxLength": 200},
    "agent_cible": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "action": {"type": "string", "minLength": 3, "maxLength": 200},
    "engage_liam": {"type": "boolean"},
    "justification": {"type": "string", "minLength": 5, "maxLength": 200}
  }
}
